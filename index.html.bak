<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Learning Login</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Arial,Helvetica,sans-serif;background:#f7f8fb;color:#555}
body{min-height:100vh;display:flex;flex-direction:column;align-items:center}
.logo-wrap{width:min(100%,1290px);padding:0 0 24px;text-align:center;background:#f7f8fb}
.logo-wrap img{display:block;width:min(1030px,86vw);height:auto;margin:18px auto 0}
.login-card{width:min(100%,1290px);min-height:1480px;background:#fff;border:2px solid #d7d9df;border-radius:30px;padding:260px 100px 85px;position:relative}
.title{text-align:center;color:#2856a8;font-size:58px;font-weight:700;margin:0 0 105px;letter-spacing:-1px}
.field{margin-bottom:72px}
.field label{display:block;color:#2856a8;font-size:48px;font-weight:600;margin:0 0 24px}
.field input{display:block;width:100%;height:132px;border:2px solid #dfe2e7;border-radius:22px;background:#fff;padding:0 28px;font-size:38px;outline:none;color:#444}
.field input:focus{border-color:#2856a8}
.show-row{display:flex;align-items:center;gap:24px;margin-top:42px;margin-bottom:160px;font-size:42px;font-weight:600;color:#555}
.show-row input{appearance:none;width:48px;height:48px;border:5px solid #e0e4e9;border-radius:10px;background:#fff;margin:0;position:relative;cursor:pointer}
.show-row input:checked{border-color:#2856a8}
.show-row input:checked:after{content:'✓';position:absolute;left:8px;top:-5px;color:#2856a8;font-size:38px;font-weight:700}
.show-row label{cursor:pointer}
.login-btn{width:100%;height:135px;border:0;border-radius:22px;background:#2856a8;color:#fff;font-size:43px;font-weight:700;cursor:pointer;font-family:inherit}
.login-btn:active{transform:translateY(1px)}
.footer{width:min(100%,1290px);text-align:center;color:#2856a8;font-size:31px;padding:55px 20px 32px;background:#f7f8fb}
@media(max-width:700px){
 .logo-wrap{padding-bottom:12px}.logo-wrap img{width:92vw;max-width:1030px;margin-top:10px}
 .login-card{min-height:auto;border-radius:20px;padding:90px 28px 45px}
 .title{font-size:34px;margin-bottom:65px}
 .field{margin-bottom:45px}.field label{font-size:28px;margin-bottom:14px}.field input{height:72px;border-radius:14px;font-size:22px}
 .show-row{font-size:25px;gap:12px;margin-top:28px;margin-bottom:95px}.show-row input{width:30px;height:30px;border-width:3px;border-radius:6px}.show-row input:checked:after{font-size:24px;left:4px;top:-5px}
 .login-btn{height:76px;border-radius:14px;font-size:28px}.footer{font-size:18px;padding:28px 12px 20px}
}
</style>
</head>
<body>
<div class="logo-wrap">
  <img src="data:image/jpeg;base64," alt="SPRIX LEARNING">
</div>
<div class="login-card">
  <h1 class="title">Learning Login</h1>
  <div class="field">
    <label for="loginId">Login ID</label>
    <input id="loginId" type="text" autocomplete="username">
  </div>
  <div class="field" style="margin-bottom:0">
    <label for="password">Password</label>
    <input id="password" type="password" autocomplete="current-password">
  </div>
  <div class="show-row">
    <input id="showPassword" type="checkbox">
    <label for="showPassword">Show Password</label>
  </div>
  <button class="login-btn" id="loginButton" type="button">Login</button>
</div>
<footer class="footer">© 2019 – 2026 QUREO, Inc. All Rights Reserved.</footer>
<script>
const password=document.getElementById('password');
document.getElementById('showPassword').addEventListener('change',function(){password.type=this.checked?'text':'password'});
document.getElementById('loginButton').addEventListener('click',function(){
  localStorage.setItem('sprix_logged_in','1');
  window.location.href='platform.html';
});
</script>
</body>
</html>
